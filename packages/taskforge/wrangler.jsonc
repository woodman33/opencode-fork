{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taskforge",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "TASK_QUEUE", "class_name": "TaskQueue" },
      { "name": "WORKFLOW_ENGINE", "class_name": "WorkflowEngine" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TaskQueue", "WorkflowEngine"]
    }
  ]
}
